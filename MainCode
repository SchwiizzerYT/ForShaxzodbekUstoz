<script>
(function(){
  "use strict";

  document.getElementById('year').textContent = new Date().getFullYear();

  var burger = document.getElementById('burgerBtn');
  var mobileMenu = document.getElementById('mobileMenu');
  burger.addEventListener('click', function(){
    mobileMenu.classList.toggle('open');
  });
  mobileMenu.querySelectorAll('a').forEach(function(a){
    a.addEventListener('click', function(){ mobileMenu.classList.remove('open'); });
  });

  var lines = [
    "root@tabrik23:~$ ./init_greeting.sh",
    "> loading modules: dart, flutter, mehr...",
    "> talabalar tilaklarini yuklamoqda... OK",
    "> status: TUG'ILGAN_KUN_MUBORAK ✔"
  ];
  var typedEl = document.getElementById('typed-line');
  var li = 0, ci = 0, currentText = "";

  function typeStep(){
    if(li >= lines.length){
      typedEl.innerHTML = currentText + '<span class="caret">&nbsp;</span>';
      return;
    }
    var line = lines[li];
    if(ci <= line.length){
      typedEl.innerHTML = currentText + line.substring(0, ci) + '<span class="caret">&nbsp;</span>';
      ci++;
      setTimeout(typeStep, 26);
    } else {
      currentText += line + "\n";
      li++;
      ci = 0;
      setTimeout(typeStep, 260);
    }
  }
  typeStep();

  var revealEls = document.querySelectorAll('.reveal');
  if('IntersectionObserver' in window){
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(entry){
        if(entry.isIntersecting){
          entry.target.classList.add('in');
          io.unobserve(entry.target);
        }
      });
    }, { threshold:.15 });
    revealEls.forEach(function(el){ io.observe(el); });
  } else {
    revealEls.forEach(function(el){ el.classList.add('in'); });
  }

  var canvas = document.getElementById('circuit-canvas');
  var ctx = canvas.getContext('2d');
  var W, H, nodes = [];
  var NODE_COUNT = Math.floor(window.innerWidth / 34);
  var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function resize(){
    W = canvas.width = window.innerWidth;
    H = canvas.height = document.documentElement.scrollHeight;
  }
  function makeNodes(){
    nodes = [];
    for(var i=0;i<NODE_COUNT;i++){
      nodes.push({
        x: Math.random()*W,
        y: Math.random()*H,
        vx: (Math.random()-0.5)*0.25,
        vy: (Math.random()-0.5)*0.25,
        purple: Math.random() > 0.6
      });
    }
  }
  function step(){
    ctx.clearRect(0,0,W,H);
    for(var i=0;i<nodes.length;i++){
      var n = nodes[i];
      if(!reduceMotion){
        n.x += n.vx; n.y += n.vy;
        if(n.x < 0 || n.x > W) n.vx *= -1;
        if(n.y < 0 || n.y > H) n.vy *= -1;
      }
      for(var j=i+1;j<nodes.length;j++){
        var m = nodes[j];
        var dx = n.x-m.x, dy = n.y-m.y;
        var dist = Math.sqrt(dx*dx+dy*dy);
        if(dist < 140){
          ctx.strokeStyle = n.purple ? 'rgba(139,92,246,' + (1-dist/140)*0.18 + ')'
                                      : 'rgba(57,255,136,' + (1-dist/140)*0.18 + ')';
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.moveTo(n.x,n.y);
          ctx.lineTo(m.x,m.y);
          ctx.stroke();
        }
      }
      ctx.fillStyle = n.purple ? 'rgba(139,92,246,0.9)' : 'rgba(57,255,136,0.9)';
      ctx.beginPath();
      ctx.arc(n.x,n.y,1.6,0,Math.PI*2);
      ctx.fill();
    }
    if(!reduceMotion) requestAnimationFrame(step);
  }

  resize();
  makeNodes();
  step();
  if(reduceMotion){ step(); }

  window.addEventListener('resize', function(){
    resize();
    NODE_COUNT = Math.floor(window.innerWidth / 34);
    makeNodes();
  });

  var statNums = document.querySelectorAll('.stat .num');
  var counted = false;
  function countUp(){
    if(counted) return;
    var statRow = document.querySelector('.stat-row');
    if(!statRow) return;
    var rect = statRow.getBoundingClientRect();
    if(rect.top > window.innerHeight) return;
    counted = true;
    statNums.forEach(function(el){
      var raw = el.textContent;
      var target = parseInt(raw, 10);
      if(isNaN(target)) return;
      var suffix = raw.replace(/[0-9]/g,'');
      var cur = 0;
      var timer = setInterval(function(){
        cur++;
        el.textContent = cur + suffix;
        if(cur >= target){ clearInterval(timer); }
      }, 45);
    });
  }
  window.addEventListener('scroll', countUp);
  countUp();

})();

