<script>
(function(){
  "use strict";

  var CITIES = {
    "Farg'ona":  { lat:40.3894, lon:71.7843 },
    "Toshkent":  { lat:41.2995, lon:69.2401 },
    "Samarqand": { lat:39.6270, lon:66.9750 },
    "Buxoro":    { lat:39.7680, lon:64.4210 },
    "Andijon":   { lat:40.7833, lon:72.3500 },
    "Namangan":  { lat:40.9983, lon:71.6726 }
  };

  var canvas = document.getElementById('weather-canvas');
  var ctx = canvas.getContext('2d');
  var particles = [];
  var mode = 'none';

  function resize(){ canvas.width = window.innerWidth; canvas.height = window.innerHeight; }
  window.addEventListener('resize', resize); resize();

  function setMode(m){
    mode = m;
    particles = [];
    var count = (m === 'rain') ? 140 : (m === 'snow') ? 90 : (m === 'wind') ? 40 : 0;
    for(var i=0;i<count;i++){
      particles.push({
        x: Math.random()*canvas.width,
        y: Math.random()*canvas.height,
        len: 10 + Math.random()*18,
        r: 1 + Math.random()*2.4,
        speed: (m==='rain'? 7+Math.random()*6 : m==='snow'? 1+Math.random()*1.6 : 2+Math.random()*3),
        drift: (m==='snow'? (Math.random()-.5)*1.2 : m==='wind'? 3+Math.random()*3 : (Math.random()-.5)*0.6)
      });
    }
  }

  function loop(){
    ctx.clearRect(0,0,canvas.width,canvas.height);
    if(mode === 'rain'){
      ctx.strokeStyle = 'rgba(180,210,255,.45)';
      ctx.lineWidth = 1.2;
      particles.forEach(function(p){
        ctx.beginPath();
        ctx.moveTo(p.x, p.y);
        ctx.lineTo(p.x + p.drift, p.y + p.len);
        ctx.stroke();
        p.y += p.speed; p.x += p.drift;
        if(p.y > canvas.height){ p.y = -20; p.x = Math.random()*canvas.width; }
      });
    } else if(mode === 'snow'){
      ctx.fillStyle = 'rgba(255,255,255,.85)';
      particles.forEach(function(p){
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI*2);
        ctx.fill();
        p.y += p.speed; p.x += p.drift + Math.sin(p.y*0.01);
        if(p.y > canvas.height){ p.y = -10; p.x = Math.random()*canvas.width; }
      });
    } else if(mode === 'wind'){
      ctx.strokeStyle = 'rgba(200,220,230,.25)';
      ctx.lineWidth = 1;
      particles.forEach(function(p){
        ctx.beginPath();
        ctx.moveTo(p.x, p.y);
        ctx.lineTo(p.x - p.len, p.y + p.len*0.15);
        ctx.stroke();
        p.x += p.speed + p.drift;
        if(p.x > canvas.width+20){ p.x = -20; p.y = Math.random()*canvas.height; }
      });
    }
    requestAnimationFrame(loop);
  }
  loop();

  var RAMADAN_RANGES = {
    2025:['2025-02-28','2025-03-30'],
    2026:['2026-02-17','2026-03-19'],
    2027:['2027-02-06','2027-03-08']
  };
  function inRange(d, startStr, endStr){
    var s = new Date(startStr+'T00:00:00'), e = new Date(endStr+'T23:59:59');
    return d >= s && d <= e;
  }
  function detectHoliday(d){
    var range = RAMADAN_RANGES[d.getFullYear()];
    if(range && inRange(d, range[0], range[1])) return 'ramadan';
    var mo = d.getMonth()+1, day = d.getDate();
    if((mo===10 && day>=25) || (mo===11 && day===1)) return 'halloween';
    if((mo===12 && day>=20) || (mo===1 && day<=7)) return 'newyear';
    if((mo===9 && day<=3) || (mo===8 && day>=28)) return 'independence';
    if(mo===3 && day>=18 && day<=23) return 'navruz';
    if(mo>=6 && mo<=8) return 'summer';
    return null;
  }

  function applyTheme(themeName){
    var body = document.body;
    ['theme-halloween','theme-newyear','theme-independence','theme-navruz','theme-ramadan','theme-summer'].forEach(function(c){ body.classList.remove(c); });
    if(themeName) body.classList.add('theme-'+themeName);
  }

  function applyWeatherMode(code){
    if((code>=51 && code<=67) || (code>=80 && code<=82) || (code>=95)) setMode('rain');
    else if((code>=71 && code<=77) || (code>=85 && code<=86)) setMode('snow');
    else setMode('none');
  }

  var VIDEO_SRC = {
    halloween_start: 'https://cdn.pixabay.com/video/2022/01/22/105296-669669130_large.mp4',
    halloween: 'https://cdn.pixabay.com/video/2025/10/06/308301_large.mp4',
    newyear:   'https://cdn.pixabay.com/video/2024/11/01/239373_large.mp4',
    ramadan:   'https://cdn.pixabay.com/video/2024/03/04/202963-919289028_large.mp4',
    summer:    'https://cdn.pixabay.com/video/2016/08/22/4753-179739298_large.mp4',
    rain:      'https://cdn.pixabay.com/video/2019/10/24/28236-368501609_large.mp4',
    night:     'https://cdn.pixabay.com/video/2018/11/29/19627-304735769_large.mp4',
    sunny:     'https://cdn.pixabay.com/video/2016/08/22/4753-179739298_large.mp4'
  };
  var bgVideo = document.getElementById('bg-video');

  function resolveVideoKey(themeName, weatherMode){
    if(themeName === 'halloween'){
      if(!sessionStorage.getItem('vx_halloween_intro_played')){
        sessionStorage.setItem('vx_halloween_intro_played','1');
        return 'halloween_start';
      }
      return 'halloween';
    }
    if(themeName === 'newyear') return 'newyear';
    if(themeName === 'ramadan') return 'ramadan';
    if(themeName === 'summer') return 'summer';
    if(themeName === 'independence' || themeName === 'navruz') return null;
    if(weatherMode === 'rain') return 'rain';
    if(weatherMode === 'snow' || weatherMode === 'wind') return null;
    var h = new Date().getHours();
    return (h >= 19 || h < 6) ? 'night' : 'sunny';
  }

  function setBgVideo(key){
    if(!bgVideo) return;
    if(!key){
      bgVideo.classList.remove('show');
      return;
    }
    var file = VIDEO_SRC[key];
    if(bgVideo.dataset.current !== key){
      bgVideo.dataset.current = key;
      bgVideo.src = file;
      bgVideo.loop = (key !== 'halloween_start');
      bgVideo.onended = (key === 'halloween_start') ? function(){ setBgVideo('halloween'); } : null;
      bgVideo.play().catch(function(){});
    }
    bgVideo.classList.add('show');
  }

  function updateBackground(themeName, weatherMode){
    setBgVideo(resolveVideoKey(themeName, weatherMode));
  }

  function fetchWeatherAndApply(city){
    var c = CITIES[city] || CITIES["Farg'ona"];
    var url = 'https://api.open-meteo.com/v1/forecast?latitude='+c.lat+'&longitude='+c.lon+'&current_weather=true&windspeed_unit=ms';
    fetch(url).then(function(r){ return r.json(); }).then(function(data){
      var cw = data && data.current_weather;
      if(!cw) return;
      window.__vexoriqWeather = cw;
      if(cw.windspeed >= 9){ setMode('wind'); updateBackground(null, 'wind'); }
      else{
        applyWeatherMode(cw.weathercode);
        updateBackground(null, mode);
      }
    }).catch(function(){
      updateBackground(null, 'none');
    });
  }

  function refreshAll(){
    var s = window.__vexoriqSettings || {};
    var override = s.theme_override || 'auto';
    var city = s.city || "Farg'ona";
    if(override && override !== 'auto'){
      var t = (override === 'none') ? null : override;
      applyTheme(t);
      if(override === 'rain' || override === 'snow' || override === 'wind'){ setMode(override); updateBackground(null, override); }
      else{ setMode('none'); updateBackground(t, 'none'); }
      return;
    }
    var holiday = detectHoliday(new Date());
    if(holiday){ applyTheme(holiday); setMode('none'); updateBackground(holiday, 'none'); return; }
    applyTheme(null);
    fetchWeatherAndApply(city);
  }

  window.__vexoriqRefreshTheme = refreshAll;
  window.__vexoriqCities = CITIES;
  if(window.__vexoriqSettings){ refreshAll(); }
  else{ document.addEventListener('vx:settingsLoaded', refreshAll, { once:true }); }
})();
</script>

<script>
(function(){
  "use strict";
  var widget = document.getElementById('game-widget');
  var reopenBtn = document.getElementById('gw-reopen');
  var minBtn = document.getElementById('gw-min');
  var nextBtn = document.getElementById('gw-next');
  var titleEl = document.getElementById('gw-title');
  var body = document.getElementById('gw-body');

  var ALL_GAMES = ['xo','snake','spinner','dino','shipwar','pacman','parkour'];
  var NAMES = { xo:'X-O', snake:'Snake', spinner:'Spinner', dino:'Chrome Dino', shipwar:'Ship War', pacman:'Pacman', parkour:'Parkour' };

  var currentDestroy = null;
  var enabledList = [];
  var idx = 0;

  function dayOfYear(d){
    var start = new Date(d.getFullYear(),0,0);
    var diff = d - start;
    return Math.floor(diff / 86400000);
  }

  function getEnabled(){
    var s = window.__vexoriqSettings || {};
    var saved = s.games;
    var list = (saved && saved.length) ? saved.filter(function(g){ return ALL_GAMES.indexOf(g)!==-1; }) : ALL_GAMES.slice();
    if(list.length === 0) list = ALL_GAMES.slice();
    return list;
  }

  function loadGame(id){
    if(currentDestroy){ try{ currentDestroy(); }catch(e){} currentDestroy = null; }
    body.innerHTML = '';
    titleEl.textContent = NAMES[id] || id;
    var factory = GAMES[id];
    if(factory) currentDestroy = factory(body) || null;
  }

  function showByIndex(){
    if(enabledList.length === 0) return;
    idx = ((idx % enabledList.length) + enabledList.length) % enabledList.length;
    loadGame(enabledList[idx]);
  }

  function refresh(){
    enabledList = getEnabled();
    idx = dayOfYear(new Date()) % enabledList.length;
    showByIndex();
  }
  window.__vexoriqRefreshGames = refresh;

  nextBtn.addEventListener('click', function(){ idx++; showByIndex(); });
  minBtn.addEventListener('click', function(){
    widget.classList.add('hidden'); reopenBtn.classList.add('show');
  });
  reopenBtn.addEventListener('click', function(){
    widget.classList.remove('hidden'); reopenBtn.classList.remove('show');
  });

  var GAMES = {};

  GAMES.xo = function(container){
    var board = document.createElement('div'); board.className = 'gw-board';
    var status = document.createElement('div'); status.className = 'gw-score';
    var cells = [null,null,null,null,null,null,null,null,null];
    var over = false;
    function lines(){ return [[0,1,2],[3,4,5],[6,7,8],[0,3,6],[1,4,7],[2,5,8],[0,4,8],[2,4,6]]; }
    function winner(){
      var L = lines();
      for(var i=0;i<L.length;i++){
        var a=L[i][0],b=L[i][1],c=L[i][2];
        if(cells[a] && cells[a]===cells[b] && cells[b]===cells[c]) return cells[a];
      }
      if(cells.every(function(c){return c;})) return 'draw';
      return null;
    }
    function render(){
      board.innerHTML = '';
      cells.forEach(function(v,i){
        var d = document.createElement('div'); d.className='gw-cell'; d.textContent = v || '';
        d.addEventListener('click', function(){
          if(over || cells[i]) return;
          cells[i] = 'X';
          var w = winner();
          if(!w){
            var empties = cells.map(function(v,i){return v?null:i;}).filter(function(v){return v!==null;});
            if(empties.length){
              var pick = empties[Math.floor(Math.random()*empties.length)];
              cells[pick] = 'O';
              w = winner();
            }
          }
          render();
          if(w){ over = true; status.textContent = w==='draw' ? 'Durang!' : (w+' yutdi!'); }
        });
        board.appendChild(d);
      });
    }
    var resetBtn = document.createElement('button'); resetBtn.className='gw-btn'; resetBtn.textContent='Qayta boshlash';
    resetBtn.addEventListener('click', function(){ cells = cells.map(function(){return null;}); over=false; status.textContent=''; render(); });
    render();
    container.appendChild(board); container.appendChild(status); container.appendChild(resetBtn);
  };

  GAMES.snake = function(container){
    var size = 150, cell = 10, n = size/cell;
    var canvas = document.createElement('canvas'); canvas.width = size; canvas.height = size;
    var ctx = canvas.getContext('2d');
    var score = document.createElement('div'); score.className='gw-score';
    var snake, dir, food, alive, timer;
    function place(){ snake=[{x:7,y:7}]; dir={x:1,y:0}; alive=true; food=randCell(); score.textContent='Ochko: 0'; }
    function randCell(){ return {x:Math.floor(Math.random()*n), y:Math.floor(Math.random()*n)}; }
    function tick(){
      if(!alive) return;
      var head = {x:snake[0].x+dir.x, y:snake[0].y+dir.y};
      if(head.x<0||head.y<0||head.x>=n||head.y>=n||snake.some(function(s){return s.x===head.x&&s.y===head.y;})){
        alive=false; score.textContent='O\'yin tugadi! Ochko: '+(snake.length-1); draw(); return;
      }
      snake.unshift(head);
      if(head.x===food.x && head.y===food.y){ food=randCell(); score.textContent='Ochko: '+(snake.length-1); }
      else snake.pop();
      draw();
    }
    function draw(){
      ctx.fillStyle='#05070a'; ctx.fillRect(0,0,size,size);
      ctx.fillStyle='#ff5fb3'; ctx.fillRect(food.x*cell,food.y*cell,cell-1,cell-1);
      ctx.fillStyle='#4dffa0';
      snake.forEach(function(s){ ctx.fillRect(s.x*cell,s.y*cell,cell-1,cell-1); });
    }
    function key(e){
      var k=e.key;
      if(k==='ArrowUp' && dir.y!==1){ dir={x:0,y:-1}; e.preventDefault(); }
      else if(k==='ArrowDown' && dir.y!==-1){ dir={x:0,y:1}; e.preventDefault(); }
      else if(k==='ArrowLeft' && dir.x!==1){ dir={x:-1,y:0}; e.preventDefault(); }
      else if(k==='ArrowRight' && dir.x!==-1){ dir={x:1,y:0}; e.preventDefault(); }
    }
    place(); draw();
    document.addEventListener('keydown', key);
    timer = setInterval(tick, 160);
    var hint = document.createElement('div'); hint.className='gw-score'; hint.textContent='Strelkalar bilan boshqaring';
    container.appendChild(canvas); container.appendChild(score); container.appendChild(hint);
    return function destroy(){ clearInterval(timer); document.removeEventListener('keydown', key); };
  };

  GAMES.spinner = function(container){
    var wrap = document.createElement('div'); wrap.style.cssText='font-size:3.4rem;cursor:pointer;user-select:none;transition:transform .05s linear;';
    wrap.textContent = '🌀';
    var score = document.createElement('div'); score.className='gw-score'; score.textContent = 'Tezlik: 0';
    var speed = 0, angle = 0, raf;
    wrap.addEventListener('click', function(){ speed += 26; });
    function loop(){
      speed *= 0.965;
      angle += speed;
      wrap.style.transform = 'rotate('+angle+'deg)';
      score.textContent = 'Tezlik: ' + Math.round(speed);
      raf = requestAnimationFrame(loop);
    }
    loop();
    var hint = document.createElement('div'); hint.className='gw-score'; hint.textContent='Bosib-bosib aylantiring';
    container.appendChild(wrap); container.appendChild(score); container.appendChild(hint);
    return function destroy(){ cancelAnimationFrame(raf); };
  };

  function makeRunner(container, theme){
    var w=200,h=110;
    var canvas=document.createElement('canvas'); canvas.width=w; canvas.height=h;
    var ctx=canvas.getContext('2d');
    var groundY=h-18, player, obstacles, score, alive, speed, raf, spawnT;
    function reset(){
      player={y:groundY-16,vy:0,size:16,jumping:false};
      obstacles=[]; score=0; alive=true; speed=2.6; spawnT=0;
    }
    function jump(){ if(!alive){ reset(); return; } if(!player.jumping){ player.vy=-6.4; player.jumping=true; } }
    function key(e){ if(e.code==='Space'||e.key===' '||e.key==='ArrowUp'){ e.preventDefault(); jump(); } }
    canvas.addEventListener('mousedown', jump);
    document.addEventListener('keydown', key);
    function tick(){
      if(alive){
        player.vy += 0.42; player.y += player.vy;
        if(player.y >= groundY-player.size){ player.y=groundY-player.size; player.vy=0; player.jumping=false; }
        spawnT--;
        if(spawnT<=0){ obstacles.push({x:w, w:8+Math.random()*10}); spawnT = 55+Math.random()*45; }
        obstacles.forEach(function(o){ o.x -= speed; });
        obstacles = obstacles.filter(function(o){ return o.x > -20; });
        obstacles.forEach(function(o){
          if(8 < o.x+o.w && 8+player.size > o.x && player.y+player.size > groundY-18 ){
            alive=false;
          }
        });
        score += 1; speed += 0.0015;
      }
      ctx.fillStyle = theme.bg; ctx.fillRect(0,0,w,h);
      ctx.fillStyle = theme.ground; ctx.fillRect(0,groundY,w,2);
      ctx.fillStyle = theme.player; ctx.fillRect(8, player.y, player.size, player.size);
      ctx.fillStyle = theme.obstacle;
      obstacles.forEach(function(o){ ctx.fillRect(o.x, groundY-18, o.w, 18); });
      ctx.fillStyle = theme.text; ctx.font='10px monospace';
      ctx.fillText((alive? 'Ochko: '+Math.floor(score/5) : 'Tugadi! Qayta uchun bosing'), 6, 12);
      raf = requestAnimationFrame(tick);
    }
    reset(); tick();
    container.appendChild(canvas);
    var hint = document.createElement('div'); hint.className='gw-score'; hint.textContent='Bosing yoki Space — sakraydi';
    container.appendChild(hint);
    return function destroy(){ cancelAnimationFrame(raf); document.removeEventListener('keydown', key); };
  }
  GAMES.dino = function(container){
    return makeRunner(container, { bg:'#05070a', ground:'#545c6c', player:'#4dffa0', obstacle:'#8b93a3', text:'#4dffa0' });
  };
  GAMES.parkour = function(container){
    return makeRunner(container, { bg:'#071a10', ground:'#19b866', player:'#33e6ff', obstacle:'#a374ff', text:'#33e6ff' });
  };

  GAMES.shipwar = function(container){
    var n=5;
    var grid = document.createElement('div'); grid.className='gw-grid5';
    var ships = {}; var found=0, total=3;
    while(total > Object.keys(ships).length){
      var k = Math.floor(Math.random()*n)+','+Math.floor(Math.random()*n);
      ships[k]=true;
    }
    var status = document.createElement('div'); status.className='gw-score'; status.textContent='Kemalarni toping: 0/3';
    for(var y=0;y<n;y++){
      for(var x=0;x<n;x++){
        (function(x,y){
          var c = document.createElement('div'); c.className='gw-cell5';
          c.addEventListener('click', function(){
            if(c.textContent) return;
            var key = x+','+y;
            if(ships[key]){ c.textContent='🔥'; found++; status.textContent='Kemalarni toping: '+found+'/3';
              if(found===total) status.textContent='G\'alaba! Barcha kemalar topildi 🎉';
            } else { c.textContent='·'; }
          });
          grid.appendChild(c);
        })(x,y);
      }
    }
    var resetBtn = document.createElement('button'); resetBtn.className='gw-btn'; resetBtn.textContent='Yangi o\'yin';
    resetBtn.addEventListener('click', function(){ loadGame('shipwar'); });
    container.appendChild(grid); container.appendChild(status); container.appendChild(resetBtn);
  };

  GAMES.pacman = function(container){
    var n=7, cell=20, w=n*cell, h=n*cell;
    var canvas=document.createElement('canvas'); canvas.width=w; canvas.height=h;
    var ctx=canvas.getContext('2d');
    var pac, ghost, dots, alive, win, timer;
    function reset(){
      pac={x:0,y:0}; ghost={x:n-1,y:n-1};
      dots=[];
      for(var y=0;y<n;y++) for(var x=0;x<n;x++){ if(!(x===0&&y===0)) dots.push(x+','+y); }
      alive=true; win=false;
    }
    function key(e){
      var k=e.key, nx=pac.x, ny=pac.y;
      if(k==='ArrowUp') ny--; else if(k==='ArrowDown') ny++;
      else if(k==='ArrowLeft') nx--; else if(k==='ArrowRight') nx++;
      else return;
      e.preventDefault();
      if(nx>=0&&ny>=0&&nx<n&&ny<n){ pac.x=nx; pac.y=ny; }
      var idx = dots.indexOf(pac.x+','+pac.y);
      if(idx!==-1) dots.splice(idx,1);
      if(dots.length===0) win=true;
    }
    function tick(){
      if(alive && !win){
        if(Math.random()<0.6){
          var dx = pac.x-ghost.x, dy = pac.y-ghost.y;
          if(Math.abs(dx)>Math.abs(dy)) ghost.x += dx>0?1:-1; else ghost.y += dy>0?1:-1;
        }
        if(ghost.x===pac.x && ghost.y===pac.y) alive=false;
      }
      ctx.fillStyle='#05070a'; ctx.fillRect(0,0,w,h);
      ctx.fillStyle='#e7ebf0';
      dots.forEach(function(d){ var p=d.split(','); ctx.beginPath(); ctx.arc(p[0]*cell+cell/2,p[1]*cell+cell/2,2,0,7); ctx.fill(); });
      ctx.fillStyle='#ffd23f'; ctx.beginPath(); ctx.arc(pac.x*cell+cell/2, pac.y*cell+cell/2, cell/2-3, 0.3, 5.98); ctx.lineTo(pac.x*cell+cell/2,pac.y*cell+cell/2); ctx.fill();
      ctx.fillStyle='#ff5555'; ctx.beginPath(); ctx.arc(ghost.x*cell+cell/2, ghost.y*cell+cell/2, cell/2-3, 0, 7); ctx.fill();
      if(!alive){ ctx.fillStyle='#ff5fb3'; ctx.font='11px monospace'; ctx.fillText('Tutildi! Qayta uchun bosing', 4, h/2); }
      if(win){ ctx.fillStyle='#4dffa0'; ctx.font='11px monospace'; ctx.fillText('G\'alaba! 🎉', 4, h/2); }
      raf = requestAnimationFrame(tick);
    }
    var raf;
    canvas.addEventListener('click', function(){ if(!alive || win){ reset(); } });
    document.addEventListener('keydown', key);
    reset(); tick();
    var hint = document.createElement('div'); hint.className='gw-score'; hint.textContent='Strelkalar — nuqtalarni yig\'ing';
    container.appendChild(canvas); container.appendChild(hint);
    return function destroy(){ cancelAnimationFrame(raf); document.removeEventListener('keydown', key); };
  };

  if(window.__vexoriqSettings){ refresh(); }
  else{ document.addEventListener('vx:settingsLoaded', refresh, { once:true }); }
})();
