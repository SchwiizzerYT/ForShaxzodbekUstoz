<!DOCTYPE html>
<html lang="uz">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Shahzodbek Baxtiyorov — Tug'ilgan kun muborak!</title>
<meta name="description" content="Shahzodbek Baxtiyorovga — Dart va Flutter ustoziga — tug'ilgan kun tabrigi.">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">

<style>
:root{
  --black:        #06070a;
  --black-soft:   #0c0f14;
  --panel:        #10141b;
  --panel-2:      #151a22;
  --line:         #232a35;

  --green:        #4dffa0;
  --green-dim:    #1c9955;
  --green-glow:   rgba(77,255,160,0.45);

  --purple:       #a374ff;
  --purple-2:     #7c3aed;
  --purple-glow:  rgba(163,116,255,0.45);

  --cyan:         #33e6ff;
  --cyan-glow:    rgba(51,230,255,0.4);

  --pink:         #ff5fb3;
  --pink-glow:    rgba(255,95,179,0.4);

  --amber:        #ffb347;

  --text:         #e7ebf0;
  --text-dim:     #8b93a3;
  --text-faint:   #545c6c;

  --font-display: 'Orbitron', sans-serif;
  --font-body:    'Space Grotesk', sans-serif;
  --font-mono:    'JetBrains Mono', monospace;

  --radius: 14px;
  --maxw: 1180px;
}

.bg-video{
  position:fixed; inset:0; z-index:0;
  width:100%; height:100%; object-fit:cover;
  opacity:0; transition:opacity 1.4s ease;
  pointer-events:none;
}
.bg-video.show{ opacity:.5; }
.bg-video-fade{
  position:fixed; inset:0; z-index:0; pointer-events:none;
  background:linear-gradient(180deg, rgba(6,7,10,.55) 0%, rgba(6,7,10,.82) 60%, rgba(6,7,10,.95) 100%);
}

.color-blobs{
  position:fixed; inset:0; z-index:0; pointer-events:none; overflow:hidden;
}
.color-blobs span{
  position:absolute; border-radius:50%; filter:blur(90px); opacity:.28;
  animation:blobfloat 22s ease-in-out infinite;
}
.color-blobs span:nth-child(1){ width:520px; height:520px; background:var(--purple); top:-180px; left:-120px; }
.color-blobs span:nth-child(2){ width:460px; height:460px; background:var(--cyan); top:30%; right:-160px; animation-delay:-7s; }
.color-blobs span:nth-child(3){ width:420px; height:420px; background:var(--green); bottom:-160px; left:20%; animation-delay:-14s; }
.color-blobs span:nth-child(4){ width:360px; height:360px; background:var(--pink); bottom:10%; right:10%; animation-delay:-4s; }
@keyframes blobfloat{
  0%,100%{ transform:translate(0,0) scale(1); }
  50%{ transform:translate(40px,-30px) scale(1.15); }
}

*,*::before,*::after{ box-sizing:border-box; margin:0; padding:0; }
html{ scroll-behavior:smooth; }
body{
  background:var(--black);
  color:var(--text);
  font-family:var(--font-body);
  line-height:1.6;
  overflow-x:hidden;
  position:relative;
}
::selection{ background:var(--green); color:var(--black); }

body::-webkit-scrollbar{ width:10px; }
body::-webkit-scrollbar-track{ background:var(--black); }
body::-webkit-scrollbar-thumb{ background:linear-gradient(var(--green-dim),var(--purple-2)); border-radius:10px; }

a{ color:inherit; text-decoration:none; }
img{ max-width:100%; display:block; }
ul{ list-style:none; }
button{ font-family:inherit; cursor:pointer; }

.wrap{ max-width:var(--maxw); margin:0 auto; padding:0 28px; }
.eyebrow{
  font-family:var(--font-mono);
  font-size:.78rem;
  letter-spacing:.22em;
  text-transform:uppercase;
  color:var(--green);
  display:flex; align-items:center; gap:10px;
  margin-bottom:14px;
}
.eyebrow::before{ content:''; width:22px; height:1px; background:var(--green); box-shadow:0 0 8px var(--green-glow); }

h1,h2,h3{ font-family:var(--font-display); line-height:1.15; letter-spacing:.01em; }
.section-title{
  font-size:clamp(1.8rem,4vw,2.7rem);
  font-weight:700;
  margin-bottom:16px;
  background:linear-gradient(90deg,var(--text) 40%,var(--green) 100%);
  -webkit-background-clip:text;
  background-clip:text;
  -webkit-text-fill-color:transparent;
}
.section-sub{
  color:var(--text-dim);
  max-width:560px;
  margin-bottom:48px;
  font-size:1rem;
}
section{ position:relative; padding:110px 0; }
.section-divider{
  height:1px;
  width:100%;
  background:linear-gradient(90deg, transparent, var(--line) 20%, var(--line) 80%, transparent);
}

#circuit-canvas{
  position:fixed; inset:0;
  width:100%; height:100%;
  z-index:0;
  opacity:.55;
  pointer-events:none;
}
.grain{
  position:fixed; inset:0; z-index:1; pointer-events:none;
  background-image:radial-gradient(rgba(255,255,255,.035) 1px, transparent 1px);
  background-size:3px 3px;
  opacity:.4;
}
.vignette{
  position:fixed; inset:0; z-index:1; pointer-events:none;
  background:radial-gradient(ellipse at center, transparent 40%, rgba(6,7,10,.75) 100%);
}

header{
  position:fixed; top:0; left:0; right:0; z-index:50;
  backdrop-filter:blur(14px);
  background:rgba(6,7,10,.65);
  border-bottom:1px solid var(--line);
}
nav.wrap{
  display:flex; align-items:center; justify-content:space-between;
  height:76px;
}
.logo{
  font-family:var(--font-display);
  font-weight:900;
  font-size:1.25rem;
  letter-spacing:.04em;
  display:flex; align-items:baseline; gap:6px;
}
.logo span.accent{ color:var(--green); text-shadow:0 0 16px var(--green-glow); }
.logo .cursor-blink{
  display:inline-block; width:9px; height:1.05em; background:var(--purple);
  margin-left:2px; animation:blink 1.1s steps(1) infinite; box-shadow:0 0 10px var(--purple-glow);
}
@keyframes blink{ 50%{ opacity:0; } }

.navlinks{ display:flex; gap:38px; }
.navlinks a{
  font-family:var(--font-mono);
  font-size:.82rem;
  letter-spacing:.06em;
  color:var(--text-dim);
  position:relative;
  padding:6px 0;
  transition:color .25s;
}
.navlinks a::before{ content:'0'attr(data-i)' · '; color:var(--purple); }
.navlinks a::after{
  content:''; position:absolute; left:0; bottom:0; height:1px; width:0%;
  background:var(--green); transition:width .3s ease; box-shadow:0 0 8px var(--green-glow);
}
.navlinks a:hover{ color:var(--text); }
.navlinks a:hover::after{ width:100%; }

.burger{
  display:none; flex-direction:column; gap:5px; width:28px; background:none; border:none;
}
.burger span{ height:2px; background:var(--green); width:100%; border-radius:2px; }

.mobile-menu{
  display:none; position:fixed; inset:76px 0 0 0; z-index:49;
  background:var(--black-soft); border-top:1px solid var(--line);
  padding:30px 28px; flex-direction:column; gap:24px;
}
.mobile-menu.open{ display:flex; }
.mobile-menu a{ font-family:var(--font-mono); font-size:1.05rem; color:var(--text); }

@media(max-width:860px){
  .navlinks{ display:none; }
  .burger{ display:flex; }
}

.hero{
  min-height:100vh;
  display:flex; align-items:center;
  position:relative; z-index:2;
  padding-top:110px;
}
.hero-grid{
  display:grid; grid-template-columns:1.1fr .9fr; gap:60px; align-items:center;
}
@media(max-width:900px){ .hero-grid{ grid-template-columns:1fr; } }

.terminal{
  background:var(--panel);
  border:1px solid var(--line);
  border-radius:var(--radius);
  padding:22px 24px;
  font-family:var(--font-mono);
  font-size:.86rem;
  color:var(--green);
  box-shadow:0 0 0 1px rgba(139,92,246,.08), 0 30px 60px -20px rgba(0,0,0,.7);
  min-height:150px;
}
.terminal .bar{
  display:flex; gap:7px; margin-bottom:16px;
}
.terminal .dot{ width:10px; height:10px; border-radius:50%; }
.terminal .dot.r{ background:#ff5f56; }
.terminal .dot.y{ background:#ffbd2e; }
.terminal .dot.g{ background:#27c93f; }
#typed-line{ white-space:pre-wrap; word-break:break-word; }
.caret{ display:inline-block; width:8px; background:var(--green); margin-left:2px; animation:blink .9s steps(1) infinite; }

.hero h1.title{
  font-size:clamp(2.4rem,6.4vw,4.6rem);
  font-weight:900;
  margin:26px 0 18px;
  letter-spacing:.01em;
}
.hero h1.title .g{ color:var(--green); text-shadow:0 0 30px var(--green-glow); }
.hero h1.title .p{ color:var(--purple); text-shadow:0 0 30px var(--purple-glow); }
.hero .tagline{
  font-size:1.15rem;
  color:var(--text-dim);
  max-width:520px;
  margin-bottom:34px;
}
.hero .tagline strong{ color:var(--text); font-weight:600; }

.btn-row{ display:flex; gap:16px; flex-wrap:wrap; }
.btn{
  font-family:var(--font-mono);
  font-size:.85rem;
  padding:14px 26px;
  border-radius:9px;
  letter-spacing:.03em;
  display:inline-flex; align-items:center; gap:10px;
  transition:transform .25s, box-shadow .25s, background .25s;
}
.btn-primary{
  background:linear-gradient(120deg,var(--green) 0%,#19b866 100%);
  color:#04140a; font-weight:700;
  box-shadow:0 8px 30px -8px var(--green-glow);
}
.btn-primary:hover{ transform:translateY(-3px); box-shadow:0 14px 34px -8px var(--green-glow); }
.btn-ghost{
  border:1px solid var(--line); color:var(--text);
  background:rgba(255,255,255,.02);
}
.btn-ghost:hover{ border-color:var(--purple); color:var(--purple); transform:translateY(-3px); }

.hero-visual{
  position:relative;
  aspect-ratio:1/1;
  display:flex; align-items:center; justify-content:center;
}
.hero-ring{
  position:absolute; inset:0; border-radius:50%;
  border:1px dashed var(--line);
  animation:spin 40s linear infinite;
}
.hero-ring.r2{ inset:40px; border-color:rgba(139,92,246,.25); animation-duration:26s; animation-direction:reverse; }
@keyframes spin{ to{ transform:rotate(360deg); } }
.hero-core{
  width:64%; aspect-ratio:1/1; border-radius:50%;
  background:conic-gradient(from 0deg, var(--green), var(--purple), var(--green));
  display:flex; align-items:center; justify-content:center;
  animation:pulse 4s ease-in-out infinite;
  box-shadow:0 0 80px -10px var(--purple-glow);
}
@keyframes pulse{ 0%,100%{ filter:brightness(1); } 50%{ filter:brightness(1.18); } }
.hero-core-inner{
  width:88%; height:88%; border-radius:50%;
  background:var(--black);
  display:flex; align-items:center; justify-content:center;
  font-family:var(--font-mono); color:var(--green); font-size:.75rem; letter-spacing:.15em;
  text-align:center; flex-direction:column; gap:6px;
}
.hero-core-inner b{ font-family:var(--font-display); color:var(--text); font-size:1.4rem; letter-spacing:.05em; }

.scroll-cue{
  position:absolute; bottom:26px; left:50%; transform:translateX(-50%);
  font-family:var(--font-mono); font-size:.7rem; color:var(--text-faint);
  display:flex; flex-direction:column; align-items:center; gap:8px;
  letter-spacing:.2em;
}
.scroll-cue .line{ width:1px; height:34px; background:linear-gradient(var(--green),transparent); animation:scrollcue 1.8s ease infinite; }
@keyframes scrollcue{ 0%{ opacity:0; transform:scaleY(.3);} 50%{opacity:1;} 100%{opacity:0; transform:scaleY(1);} }

.about-grid{
  display:grid; grid-template-columns:.8fr 1.2fr; gap:64px; align-items:center;
}
@media(max-width:860px){ .about-grid{ grid-template-columns:1fr; } }

.avatar-frame{
  position:relative; width:100%; max-width:340px; margin:0 auto;
}
.avatar-frame .ring{
  position:absolute; inset:-14px; border-radius:50%;
  border:1px solid var(--line);
}
.avatar-frame .ring::before,.avatar-frame .ring::after{
  content:''; position:absolute; width:8px; height:8px; border-radius:50%;
  background:var(--green); box-shadow:0 0 10px var(--green-glow);
}
.avatar-frame .ring::before{ top:-4px; left:50%; }
.avatar-frame .ring::after{ bottom:-4px; left:50%; background:var(--purple); box-shadow:0 0 10px var(--purple-glow); }
.avatar-img{
  width:100%; aspect-ratio:1/1; border-radius:50%; object-fit:cover;
  border:2px solid var(--green);
  filter:grayscale(.15) contrast(1.05);
}
.avatar-tag{
  margin-top:22px; text-align:center; font-family:var(--font-mono); font-size:.75rem;
  color:var(--text-dim); letter-spacing:.1em;
}

.bio p{ color:var(--text-dim); margin-bottom:16px; font-size:1.02rem; }
.bio strong{ color:var(--green); font-weight:600; }

.stat-row{
  display:grid; grid-template-columns:repeat(3,1fr); gap:18px; margin-top:34px;
}
.stat{
  background:var(--panel); border:1px solid var(--line); border-radius:12px;
  padding:20px 16px; text-align:center;
}
.stat .num{
  font-family:var(--font-mono); font-size:1.9rem; font-weight:700; color:var(--green);
}
.stat .lbl{ font-size:.72rem; color:var(--text-faint); letter-spacing:.08em; text-transform:uppercase; margin-top:6px; }

.tool-grid{
  display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:16px;
}
.tool-card{
  background:var(--panel); border:1px solid var(--line); border-radius:12px;
  padding:22px 18px; text-align:center;
  transition:transform .25s, border-color .25s, background .25s;
}
.tool-card:hover{ transform:translateY(-6px); border-color:var(--green); background:var(--panel-2); }
.tool-card .ic{ font-size:1.9rem; margin-bottom:10px; }
.tool-card .name{ font-family:var(--font-mono); font-size:.86rem; color:var(--text); }
.tool-card .role{ font-size:.72rem; color:var(--text-faint); margin-top:4px; }

.project-grid{
  display:grid; grid-template-columns:repeat(2,1fr); gap:28px;
}
@media(max-width:860px){ .project-grid{ grid-template-columns:1fr; } }

.card{
  background:var(--panel);
  border:1px solid var(--line);
  border-radius:var(--radius);
  overflow:hidden;
  position:relative;
  transition:transform .35s ease, border-color .35s ease, box-shadow .35s ease;
}
.card:hover{
  transform:translateY(-8px);
  border-color:var(--purple);
  box-shadow:0 24px 50px -22px var(--purple-glow), 0 0 0 1px rgba(139,92,246,.15);
}
.card-media{
  position:relative; aspect-ratio:16/10; overflow:hidden; background:var(--black-soft);
  display:flex; align-items:center; justify-content:center;
}
.card-media img{ width:100%; height:100%; object-fit:cover; transition:transform .5s ease; filter:saturate(1.05) contrast(1.02); }
.card:hover .card-media img{ transform:scale(1.06); }
.card-media .noimg{
  font-family:var(--font-mono); font-size:.75rem; color:var(--text-faint); text-align:center; padding:20px;
  letter-spacing:.05em;
}
.card-media::after{
  content:''; position:absolute; inset:0;
  background:linear-gradient(180deg, transparent 55%, rgba(6,7,10,.85) 100%);
}
.card-status{
  position:absolute; top:14px; right:14px; z-index:2;
  font-family:var(--font-mono); font-size:.65rem; letter-spacing:.08em;
  padding:5px 10px; border-radius:20px;
  background:rgba(6,7,10,.75); border:1px solid var(--green);
  color:var(--green); text-transform:uppercase;
}
.card-body{ padding:24px; }
.card-tag{
  font-family:var(--font-mono); font-size:.7rem; color:var(--purple);
  letter-spacing:.1em; text-transform:uppercase; margin-bottom:8px; display:block;
}
.card-body h3{ font-size:1.28rem; margin-bottom:10px; color:var(--text); font-weight:700; }
.card-body p{ color:var(--text-dim); font-size:.92rem; margin-bottom:16px; }
.chip-row{ display:flex; flex-wrap:wrap; gap:8px; }
.chip{
  font-family:var(--font-mono); font-size:.68rem; color:var(--text-dim);
  border:1px solid var(--line); border-radius:20px; padding:5px 12px;
}

.contact-grid{
  display:grid; grid-template-columns:repeat(4,1fr); gap:20px;
}
@media(max-width:860px){ .contact-grid{ grid-template-columns:repeat(2,1fr); } }
.social-card{
  background:var(--panel); border:1px solid var(--line); border-radius:var(--radius);
  padding:28px 20px; text-align:center;
  transition:transform .3s, border-color .3s, background .3s;
  display:flex; flex-direction:column; align-items:center; gap:10px;
}
.social-card:hover{ transform:translateY(-6px); border-color:var(--green); background:var(--panel-2); }
.social-card .ic{
  width:46px; height:46px; border-radius:50%;
  display:flex; align-items:center; justify-content:center;
  background:rgba(57,255,136,.08); border:1px solid var(--green);
  font-size:1.3rem;
}
.social-card .lbl{ font-family:var(--font-mono); font-size:.78rem; color:var(--text); }
.social-card .handle{ font-size:.72rem; color:var(--text-faint); word-break:break-word; }

.cta-panel{
  margin-top:70px;
  border:1px solid var(--line); border-radius:var(--radius);
  background:linear-gradient(120deg, rgba(57,255,136,.06), rgba(139,92,246,.06));
  padding:50px 40px; text-align:center;
}
.cta-panel h3{ font-size:1.6rem; margin-bottom:12px; }
.cta-panel p{ color:var(--text-dim); margin-bottom:24px; }

footer{
  border-top:1px solid var(--line);
  padding:34px 0;
  position:relative; z-index:2;
}
footer .wrap{
  display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:14px;
}
footer .fmono{ font-family:var(--font-mono); font-size:.75rem; color:var(--text-faint); }
footer .fmono b{ color:var(--green); }

.reveal{ opacity:0; transform:translateY(28px); transition:opacity .7s ease, transform .7s ease; }
.reveal.in{ opacity:1; transform:translateY(0); }

a:focus-visible, button:focus-visible{
  outline:2px solid var(--green); outline-offset:3px; border-radius:4px;
}

@media (prefers-reduced-motion: reduce){
  *{ animation:none !important; transition:none !important; }
}

#weather-canvas{
  position:fixed; inset:0; z-index:1; pointer-events:none; opacity:.85;
}
#season-deco{
  position:fixed; inset:0; z-index:1; pointer-events:none;
  transition:background 1.2s ease;
}
body.theme-halloween #season-deco{
  background:radial-gradient(circle at 15% 10%, rgba(255,140,0,.16), transparent 55%),
             radial-gradient(circle at 85% 85%, rgba(122,0,168,.18), transparent 55%);
}
body.theme-halloween #season-deco::before{
  content:'🎃'; position:absolute; top:6%; right:5%; font-size:3rem; opacity:.6;
  filter:drop-shadow(0 0 18px rgba(255,140,0,.5));
  animation:seasonFloat 5s ease-in-out infinite;
}
body.theme-halloween #season-deco::after{
  content:'🦇'; position:absolute; top:16%; left:8%; font-size:2rem; opacity:.5;
  animation:batFly 9s ease-in-out infinite;
}
body.theme-newyear #season-deco{
  background:radial-gradient(circle at 20% 15%, rgba(255,80,80,.14), transparent 55%),
             radial-gradient(circle at 80% 20%, rgba(80,220,255,.14), transparent 55%);
}
body.theme-newyear #season-deco::before{
  content:'🎄'; position:absolute; top:8%; left:6%; font-size:3rem; opacity:.65;
  animation:seasonFloat 6s ease-in-out infinite;
}
body.theme-newyear #season-deco::after{
  content:'🎆'; position:absolute; top:10%; right:8%; font-size:2.6rem; opacity:.55;
  animation:seasonFloat 4s ease-in-out infinite;
}
body.theme-independence #season-deco{
  background:linear-gradient(180deg, rgba(0,153,74,.10), transparent 40%),
             radial-gradient(circle at 85% 15%, rgba(0,102,204,.14), transparent 55%);
}
body.theme-independence #season-deco::before{
  content:'🇺🇿'; position:absolute; top:7%; right:6%; font-size:2.8rem; opacity:.7;
  animation:seasonFloat 5s ease-in-out infinite;
}
body.theme-navruz #season-deco{
  background:radial-gradient(circle at 15% 12%, rgba(120,230,120,.16), transparent 55%),
             radial-gradient(circle at 85% 80%, rgba(255,210,90,.14), transparent 55%);
}
body.theme-navruz #season-deco::before{
  content:'🌱'; position:absolute; top:8%; left:7%; font-size:2.6rem; opacity:.6;
  animation:seasonFloat 5s ease-in-out infinite;
}
body.theme-navruz #season-deco::after{
  content:'🌷'; position:absolute; top:14%; right:7%; font-size:2.4rem; opacity:.6;
  animation:seasonFloat 6s ease-in-out infinite;
}
body.theme-ramadan #season-deco{
  background:radial-gradient(circle at 20% 10%, rgba(255,210,120,.14), transparent 55%),
             radial-gradient(circle at 80% 15%, rgba(90,110,255,.14), transparent 55%);
}
body.theme-ramadan #season-deco::before{
  content:'🌙'; position:absolute; top:8%; right:8%; font-size:2.8rem; opacity:.65;
  animation:seasonFloat 6s ease-in-out infinite;
}
body.theme-ramadan #season-deco::after{
  content:'🏮'; position:absolute; top:16%; left:8%; font-size:2.2rem; opacity:.55;
  animation:seasonFloat 5s ease-in-out infinite;
}
body.theme-summer{ --black:#071a22; --black-soft:#0b2530; }
body.theme-summer #season-deco{
  background:linear-gradient(180deg, rgba(255,205,110,.10) 0%, rgba(0,150,200,.14) 55%, rgba(0,90,140,.20) 100%);
